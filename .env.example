# Salin ke .env lalu isi nilainya. File .env tidak ikut git.

# Wajib. Minimal 32 karakter.
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_TTL_MINUTES=30

# Kredensial Postgres untuk Docker Compose.
# Pakai karakter alfanumerik supaya aman dipakai di URL DB_URL.
POSTGRES_USER=boxsight
POSTGRES_PASSWORD=ganti-password-postgres
POSTGRES_DB=boxsight

MAX_UPLOAD_BYTES=5242880
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
