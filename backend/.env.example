# Salin ke .env lalu isi nilainya. File .env tidak ikut git.
# JWT_SECRET wajib diisi, minimal 32 karakter.
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_TTL_MINUTES=30

# Pengembangan lokal memakai Postgres dari container.
# Ganti password dan port sesuai .env di root project.
DB_URL=postgresql+psycopg://boxsight:ganti-password@127.0.0.1:5433/boxsight
TEST_DATABASE_URL=postgresql+psycopg://boxsight:ganti-password@127.0.0.1:5433/boxsight_test
STORAGE_DIR=./storage/images
MAX_UPLOAD_BYTES=5242880

# yolo memakai model/weights/best.pt, stub dipakai tes.
INFERENCE_BACKEND=yolo
# Opsional. Default sudah menunjuk ke model/weights/best.pt dari root project.
# MODEL_PATH=../model/weights/best.pt

# Origin frontend untuk CORS
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
